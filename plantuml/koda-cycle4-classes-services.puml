@startuml
title Cycle 4 - Classes principales services et adapters

skinparam classAttributeIconSize 0
skinparam shadowing false

class AppConfig {
  BackendConfig backend
  RespeakerConfig respeaker
  NextionConfig nextion
  ArduinoConfig arduino
  WakeWordConfig wake_word
  VoskConfig vosk
  RotationConfig rotation
}

class BackendClient {
  +health()
  +speech_to_text(wav)
  +text_to_speech(text)
  +speech_to_action(wav)
  +trigger_n8n(message)
}

class ActionResult {
  action
  input_text
  spoken_text
  audio_wav
  music_url
  motion_command
}

class ConversationService {
  +listen_and_answer()
  +run_turn(seconds)
  -_dispatch_action(result)
}

class WakeWordService {
  +prepare()
  +wait_for_wake(stop_event)
}

class VoskWakeWordEngine {
  +prepare()
  +wait_for_wake(stop_event)
}

class ContinuousListenerService {
  +listen()
}

class DisplayService {
  +set_expression(expression)
  +resume_idle()
}

class MotionService {
  +hello()
  +forward()
  +left()
  +right()
  +stop()
  +rotate_by_angle(angle)
}

class SpeechService {
  +speak(text)
  +play_wav(wav)
}

class MusicPlayer {
  +play_from_url(url)
}

class RespeakerAdapter {
  +record_wav(seconds)
  +stream_pcm(chunk_bytes)
}

class NextionAdapter {
  +open()
  +send(command)
  +close()
}

class ArduinoAdapter {
  +open()
  +send(command)
  +close()
}

class AudioOutputAdapter {
  +ensure_bluetooth()
  +play_wav_file(path)
}

ConversationService --> BackendClient
ConversationService --> DisplayService
ConversationService --> MotionService
ConversationService --> SpeechService
ConversationService --> ContinuousListenerService
ConversationService --> MusicPlayer
BackendClient --> ActionResult
WakeWordService --> VoskWakeWordEngine
WakeWordService --> BackendClient
WakeWordService --> RespeakerAdapter
ContinuousListenerService --> RespeakerAdapter
DisplayService --> NextionAdapter
MotionService --> ArduinoAdapter
SpeechService --> BackendClient
SpeechService --> AudioOutputAdapter
MusicPlayer --> AudioOutputAdapter
AppConfig ..> BackendClient
AppConfig ..> RespeakerAdapter
AppConfig ..> NextionAdapter
AppConfig ..> ArduinoAdapter

@enduml
