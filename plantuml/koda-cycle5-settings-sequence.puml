@startuml
title Cycle 5 - Sequence configuration robot et parametres

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #1F5E7A
  LifeLineBorderColor #246B80
  ParticipantBorderColor #246B80
  ParticipantBackgroundColor #F7FCFF
}

actor Utilisateur as U
participant "RobotSetupPage /\nSettingsPage" as Page
participant "RobotSetupViewModel /\nSettingsViewModel" as VM
participant "DistributeurApiService" as API
participant "Backend FastAPI" as Backend
participant "SessionService" as Session
database "Preferences" as Prefs

Page -> VM : OnAppearingAsync()
VM -> API : GetFullSettingsAsync()
API -> Backend : GET /api/settings
Backend --> API : settings JSON
API --> VM : JsonElement
VM --> Page : binding champs\nname, sexe, date,\nlangue, etat...

U -> Page : modifier puis sauvegarder
Page -> VM : SaveCommand /\nSaveSettingsCommand
VM -> API : UpdateSettingsAsync(payload)
API -> Backend : PUT /api/settings
Backend --> API : 200 OK

alt premiere configuration
  VM -> Session : SetRobotConfigured(true)
  Session -> Prefs : km_robot_configured=true
  VM --> U : retour vers AppShell
else parametres
  VM --> U : confirmation sauvegarde
end

@enduml
