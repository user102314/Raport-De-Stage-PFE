@startuml
title Cycle 4 - Dispatch des actions retournees par le backend

skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam ParticipantPadding 10
skinparam shadowing false

participant "ConversationService" as CONV
participant "BackendClient" as API
participant "DisplayService" as DISPLAY
participant "SpeechService" as SPEECH
participant "MusicPlayer" as MUSIC
participant "MotionDispatcher" as DISPATCH
participant "MotionService" as MOTION

CONV -> API : speech_to_action(wav)
API --> CONV : ActionResult

alt action = text
  CONV -> DISPLAY : SINGING
  CONV -> SPEECH : play_wav(audio_wav)
else action = music
  CONV -> SPEECH : annonce vocale
  CONV -> DISPLAY : SINGING
  CONV -> MUSIC : download/cache/play(music_url)
else action = motion
  CONV -> SPEECH : accuse reception
  CONV -> DISPATCH : execute(motion_command)
  DISPATCH -> MOTION : forward/backward/left/right/stop
else action = sleep
  CONV -> SPEECH : message de fin
  CONV -> DISPLAY : SLEEPING
else action = error
  CONV -> DISPLAY : SAD
end

CONV -> DISPLAY : resume_idle()

@enduml
