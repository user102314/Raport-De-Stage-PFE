@startuml
title Cycle 4 - Le logiciel Raspberry comme corps operationnel de KODA

skinparam shadowing false
skinparam componentStyle rectangle
skinparam defaultFontSize 11

rectangle "Logiciel Raspberry Pi" as CORE #E8F4FF {
  component "Oreille\nWake + VAD" as EAR
  component "Orientation\nDOA + rotation" as ORIENT
  component "Voix\nTTS + lecture" as VOICE
  component "Visage\nNextion expressions" as FACE
  component "Corps\nArduino motions" as BODY
  component "Memoire distante\nBackend + n8n" as MEMORY
}

cloud "Backend FastAPI" as BACKEND #FDEDEC
database "n8n / Supabase" as N8N #F4ECF7

EAR --> MEMORY : audio
MEMORY --> VOICE : reponse
MEMORY --> BODY : commande
MEMORY --> FACE : emotion implicite
ORIENT --> BODY : pivoter vers locuteur

MEMORY --> BACKEND
BACKEND --> N8N
N8N --> BACKEND
BACKEND --> MEMORY

note bottom of CORE
  Le Pi ne remplace pas le cerveau n8n :
  il transforme les decisions en comportements physiques.
end note

@enduml
