@startuml
title Cycle 5 - Cas d'utilisation KodaMate

left to right direction
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam usecase {
  BorderColor #246B80
  BackgroundColor #F7FCFF
}
skinparam actor {
  BorderColor #333333
}

actor "Utilisateur" as User
actor "Backend\nFastAPI" as Backend
actor "Open-Meteo" as Meteo
actor "Android Wi-Fi" as Wifi

rectangle "Application KodaMate" {
  usecase "Configurer l'URL\nserveur" as UCServer
  usecase "Tester la\njoignabilite" as UCTest
  usecase "Se connecter" as UCLogin
  usecase "Configurer le\nrobot" as UCRobotSetup
  usecase "Consulter l'accueil\nstatut + meteo" as UCHome
  usecase "Allumer / eteindre\nKODA" as UCPower
  usecase "Dialoguer avec\nKODA" as UCChat
  usecase "Prendre une photo\npour le chat" as UCPhoto
  usecase "Consulter et filtrer\nl'historique" as UCHistory
  usecase "Modifier les\nparametres" as UCSettings
  usecase "Choisir un reseau\nWi-Fi simule" as UCWifi
  usecase "Recevoir et gerer\nnotifications demo" as UCNotif
  usecase "Se deconnecter" as UCLogout
}

User --> UCServer
User --> UCTest
User --> UCLogin
User --> UCRobotSetup
User --> UCHome
User --> UCPower
User --> UCChat
User --> UCPhoto
User --> UCHistory
User --> UCSettings
User --> UCWifi
User --> UCNotif
User --> UCLogout

UCLogin --> Backend : /auth/login
UCTest --> Backend : GET racine
UCRobotSetup --> Backend : GET/PUT /settings
UCHome --> Backend : GET /settings
UCHome --> Meteo : forecast
UCPower --> Backend : /power-on\n/power-off
UCChat --> Backend : POST /trigger-n8n
UCHistory --> Backend : GET /conversations
UCSettings --> Backend : GET/PUT /settings
UCWifi --> Wifi : scan si Android

UCPhoto .> UCChat : <<extend>>

@enduml
