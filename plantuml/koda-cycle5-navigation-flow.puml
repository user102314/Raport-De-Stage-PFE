@startuml
title Cycle 5 - Navigation et bootstrap de KodaMate

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam activity {
  BorderColor #246B80
  BackgroundColor #F7FCFF
  DiamondBorderColor #246B80
  DiamondBackgroundColor #EAF8FC
}

start
:Creation de App;
:Afficher une page de chargement\nlogo KODA + indicateur;
:SessionBootstrap.ValidateStoredSessionAsync;
if (Session locale complete ?) then (oui)
  :Ping du backend\nracine HTTP;
  if (Backend joignable ?) then (oui)
    :GET /api/settings;
    if (Robot deja configure ?) then (oui)
      :Creer AppShell;
      :Charger les onglets\nHome, Chat, History, Settings;
      stop
    else (non)
      :Afficher RobotSetupPage;
      :PUT /api/settings;
      :Marquer robot configure;
      :Relancer depuis la session;
      stop
    endif
  else (non)
    :Effacer la session locale;
    :Afficher LoginPage;
    stop
  endif
else (non)
  :Afficher LoginPage;
  :Tester l'URL serveur si besoin;
  :POST /api/auth/login;
  if (Authentification OK ?) then (oui)
    :Sauver email, idProduit, idKoda;
    :Relancer depuis la session;
    stop
  else (non)
    :Afficher message d'erreur;
    stop
  endif
endif

@enduml
