@startuml
title Cycle 4 - Machine d'etats logicielle du robot

skinparam shadowing false
skinparam state {
  BackgroundColor #E8F4FF
  BorderColor #336699
}

[*] --> BOOT
BOOT --> DIAGNOSTIC : load_config
DIAGNOSTIC --> INIT : checks termines
INIT --> PASSIVE : services prets

PASSIVE --> WAKE : mot reveil detecte
WAKE --> ORIENTING : DOA disponible
ORIENTING --> GREETING : rotation terminee
GREETING --> LISTENING : salutation jouee
LISTENING --> PROCESSING : audio capture
PROCESSING --> SPEAKING : action text/music
PROCESSING --> MOVING : action motion
PROCESSING --> SLEEPING : action sleep
PROCESSING --> ERROR : action error

SPEAKING --> FOLLOW_UP : pause inter-tour
MOVING --> FOLLOW_UP : commande terminee
FOLLOW_UP --> LISTENING : parole detectee
FOLLOW_UP --> PASSIVE : silences max atteints

SLEEPING --> PASSIVE : retour veille
ERROR --> PASSIVE : expression SAD puis idle
PASSIVE --> SHUTDOWN : SIGINT/SIGTERM
SHUTDOWN --> [*]

@enduml
