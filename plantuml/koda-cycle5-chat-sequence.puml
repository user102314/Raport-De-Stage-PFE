@startuml
title Cycle 5 - Sequence chat KodaMate vers n8n

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Arial
skinparam sequence {
  ArrowColor #1F5E7A
  LifeLineBorderColor #246B80
  ParticipantBorderColor #246B80
  ParticipantBackgroundColor #F7FCFF
}

actor Utilisateur as U
participant "ChatPage\nXAML" as Page
participant "ChatViewModel" as VM
participant "ObservableCollection\nMessages" as Msgs
participant "DistributeurApiService" as API
participant "Backend FastAPI" as Backend
participant "Workflow n8n" as N8N

U -> Page : ecrire un message
Page -> VM : SendMessageCommand
VM -> Msgs : ajouter message utilisateur
VM -> VM : IsTyping = true
VM -> API : SendToN8nAsync(question)
API -> Backend : POST /api/trigger-n8n\n{ question }
Backend -> N8N : transmettre la demande IA
N8N --> Backend : reponse structuree ou texte
Backend --> API : JSON response/answer/output/text...
API --> VM : texte de reponse
VM -> Msgs : ajouter reponse KODA
VM -> VM : IsTyping = false

alt backend indisponible
  API --> VM : HttpRequestException
  VM -> Msgs : message d'erreur reseau
end

opt photo
  U -> Page : CapturePhoto
  Page -> VM : TakePhotoCommand
  VM -> Msgs : ajouter image locale
  VM -> API : SendToN8nAsync(description textuelle)
end

@enduml
